{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latch-keeper",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  // Every minute. Each vault's own on-chain rules decide whether a buy is allowed.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "FACTORY_ADDRESS": "",
    "RPC_URL": "https://rpc.xlayer.tech",
    "CHAIN_ID": "196",
    "MAX_DIVERGENCE_PCT": "2",
    "MAX_SENDS_PER_RUN": "5",
    "MAX_GAS_GWEI": "50"
  }
  // KEEPER_PRIVATE_KEY is a secret: npx wrangler secret put KEEPER_PRIVATE_KEY
}
