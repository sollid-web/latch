{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latch-keeper",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  // Every 2 minutes. The vault's own limits (2 per transfer, 6 per day) cap what can move.
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "RELAY_ADDRESS": "0x7952C9B53347518b29016d2EAed8690A9808a2A0",
    "RPC_URL": "https://rpc.xlayer.tech",
    "CHAIN_ID": "196",
    "THRESHOLD": "48",
    "SWEEP_USDT": "2",
    "MAX_SPREAD_PCT": "6",
    "MAX_GAS_GWEI": "50"
  }
  // KEEPER_PRIVATE_KEY is a secret: npx wrangler secret put KEEPER_PRIVATE_KEY
}
