{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latch-keeper",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  // Every minute. Each vault's own on-chain rules decide whether a buy is allowed.
  "triggers": { "crons": ["* * * * *"] },
  // Trade history recorded by the bot (GET /trades). Read-only data; anyone can re-check each tx on OKLink.
  "kv_namespaces": [{ "binding": "TRADES", "id": "53c81bd92ac2455eb1aef438b8758327" }],
  "vars": {
    "FACTORY_ADDRESS": "0xc700C9865f237612b0bA86408BB4C182D41ABD11",
    "FACTORY2_ADDRESS": "0x9C647a631fe59813c430D03330C3A4Da21df6428",
    "RPC_URL": "https://rpc.xlayer.tech",
    "CHAIN_ID": "196",
    "MAX_DIVERGENCE_PCT": "2",
    "MAX_SENDS_PER_RUN": "5",
    "MAX_GAS_GWEI": "50"
  }
  // KEEPER_PRIVATE_KEY is a secret: npx wrangler secret put KEEPER_PRIVATE_KEY
}
